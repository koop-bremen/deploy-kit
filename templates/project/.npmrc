# deploy-kit-Standard für Node-Projekte (npm >= 11.10).
# Keine Install-Skripte von Abhängigkeiten: postinstall ist der häufigste Weg, über den ein kompromittiertes
# Paket beim Installieren Code ausführt und Tokens stiehlt. Pakete, die wirklich ein Build-Skript brauchen
# (esbuild, sharp, …), werden im Build gezielt mit `npm rebuild <paket>` nachgezogen.
ignore-scripts=true
# Keine Versionen installieren, die jünger als 7 Tage sind. Sicherheitsfix sofort nötig:
#   npm install <paket>@<version> --min-release-age=0   (bewusst, einzeln, mit Commit-Begründung)
min-release-age=7
# Nur die offizielle Registry, nur mit Lockfile.
registry=https://registry.npmjs.org/
package-lock=true
audit-level=high
